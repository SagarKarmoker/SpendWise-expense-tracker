{
    "version": 2,
    "builds": [
        {
            "src": "apps/api/src/main.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "packages/types/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "apps/api/src/main.ts"
        }
    ]
}